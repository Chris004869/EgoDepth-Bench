--- a/unidac/utils/erp_geometry.py
+++ b/unidac/utils/erp_geometry.py
@@ -160,7 +160,54 @@
 
     # Important: this normalization needs to use the source perspective image FOV, for the grid sample function range [-1, 1]
     # Gnomonic Projection for OPENCV_FISHEYE model, only works for FOV < 180 degree
-    if 'camera_model' in cam_params.keys() and cam_params['camera_model'] == 'OPENCV_FISHEYE':    
+    # ---------------------------------------------------------------------
+    # EgoDepth-Bench patch: double-sphere (DS) forward projection.
+    #
+    # `cam_to_erp_patch_fast` supports OPENCV_FISHEYE, MEI and ERP. The
+    # EgoDepth-Bench rig is double-sphere, which is none of these: MEI has no
+    # `alpha`, and OPENCV_FISHEYE is a polynomial in theta. Without this branch a
+    # DS camera can only be forced through one of the other models, which
+    # misprojects and produces plausible-looking depth on the wrong pixels.
+    #
+    # This is the standard DS projection (Usenko et al.), applied to the Gnomonic
+    # ray (x_num, y_num, cos_c) that the code above already computed:
+    #     d1 = sqrt(x^2 + y^2 + z^2)
+    #     d2 = sqrt(x^2 + y^2 + (xi*d1 + z)^2)
+    #     u  = fx * x / (alpha*d2 + (1-alpha)*(xi*d1 + z)) + cx
+    # The reverse direction (ERP patch -> camera) already accepts a ray lookup
+    # table, so only the forward direction needed adding.
+    #
+    # Kept as a recorded local patch; see docs/third_party_patches.md.
+    if 'camera_model' in cam_params.keys() and cam_params['camera_model'] == 'DS':
+        fx = cam_params['fx']
+        fy = cam_params['fy']
+        cx = cam_params['cx']
+        cy = cam_params['cy']
+        xi = cam_params['xi']
+        alpha = cam_params['alpha']
+
+        d1 = torch.sqrt(x_num * x_num + y_num * y_num + cos_c * cos_c)
+        z_shifted = xi * d1 + cos_c
+        d2 = torch.sqrt(x_num * x_num + y_num * y_num + z_shifted * z_shifted)
+        denominator = alpha * d2 + (1.0 - alpha) * z_shifted
+        # Rays the DS model cannot project land outside the image, which the
+        # normalization below turns into out-of-range grid coordinates that
+        # grid_sample fills with padding -- the same treatment other models' invalid
+        # rays get.
+        denominator = torch.where(
+            denominator.abs() < 1e-9,
+            torch.full_like(denominator, 1e-9),
+            denominator,
+        )
+        new_x = fx * x_num / denominator + cx
+        new_y = fy * y_num / denominator + cy
+
+        new_x -= img_w / 2
+        new_x /= (img_w / 2)
+        new_y -= img_h / 2
+        new_y /= (img_h / 2)
+
+    elif 'camera_model' in cam_params.keys() and cam_params['camera_model'] == 'OPENCV_FISHEYE':    
         """
             Apply opencv distortion (Refer to: OpenCV)
         """
